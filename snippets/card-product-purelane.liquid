{% comment %}
  Purelane Theme - Reusable Product Card Snippet
  Handles edge cases: sold out, missing images, long titles, compare prices, badges, and AJAX cart submission.
  Usage: {% render 'card-product-purelane', card_product: product, badge_label: 'Best seller' %}
{% endcomment %}

{%- liquid
  assign product = card_product
  assign is_available = product.available
  assign featured_img = product.featured_media | default: product.featured_image
  assign title = product.title | default: 'Purelane Botanical Product'
  assign price = product.price | default: 20000
  assign compare_price = product.compare_at_price | default: 29900
  assign badge = badge_label

  if compare_price > price
    assign savings = compare_price | minus: price
    assign save_pct = savings | times: 100.0 | divided_by: compare_price | round
  endif

  assign rating_val = product.metafields.reviews.rating.value.rating | default: '4.8'
  assign rating_count = product.metafields.reviews.rating_count | default: 237
-%}

<article class="glass card rv{% if class_suffix %} {{ class_suffix }}{% endif %}" data-product-id="{{ product.id }}">
  <div class="shot">
    {% if is_available == false %}
      <span class="pill sold-out">Sold out</span>
    {% elsif badge != blank %}
      <span class="pill">{{ badge }}</span>
    {% elsif save_pct and save_pct > 0 %}
      <span class="pill">{{ save_pct }}% off</span>
    {% endif %}

    <a href="{{ product.url | default: '#shop' }}" class="pimg-link" aria-label="{{ title | escape }}" style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;">
      {% if featured_img %}
        {{
          featured_img
          | image_url: width: 400
          | image_tag:
            loading: 'lazy',
            widths: '150, 300, 400',
            sizes: '(max-width: 600px) 150px, 300px',
            class: 'purelane-card-image',
            style: 'max-height:122px;width:auto;object-fit:contain;'
        }}
      {% else %}
        <div style="height:122px;width:80px;display:flex;align-items:center;justify-content:center;">
          {% assign p_handle = product.handle | default: 'tap' %}
          {% if p_handle contains 'kitchen' %}
            {% render 'purelane-product-icon', handle: 'kitchen' %}
          {% elsif p_handle contains 'dish' %}
            {% render 'purelane-product-icon', handle: 'dish' %}
          {% elsif p_handle contains 'laundry' %}
            {% render 'purelane-product-icon', handle: 'laundry' %}
          {% elsif p_handle contains 'floor' %}
            {% render 'purelane-product-icon', handle: 'floor' %}
          {% elsif p_handle contains 'toilet' %}
            {% render 'purelane-product-icon', handle: 'toilet' %}
          {% elsif p_handle contains 'handwash' %}
            {% render 'purelane-product-icon', handle: 'handwash' %}
          {% elsif p_handle contains 'metal' or p_handle contains 'copper' or p_handle contains 'brass' %}
            {% render 'purelane-product-icon', handle: 'metal' %}
          {% elsif p_handle contains 'machine' or p_handle contains 'wm' %}
            {% render 'purelane-product-icon', handle: 'wm' %}
          {% else %}
            {% render 'purelane-product-icon', handle: 'tap' %}
          {% endif %}
        </div>
      {% endif %}
    </a>
  </div>

  <h4>
    <a href="{{ product.url | default: '#shop' }}">{{ title | truncate: 60 }}</a>
  </h4>

  <div class="rate">
    <b>★ {{ rating_val }}</b> · {{ rating_count }} reviews
  </div>

  <div class="pr">
    <strong>{{ price | money }}</strong>
    {% if compare_price > price %}
      <s>{{ compare_price | money }}</s>
      {% if save_pct and save_pct > 0 %}
        <em>{{ save_pct }}% off</em>
      {% endif %}
    {% endif %}
  </div>

  {% if is_available %}
    <form method="post" action="{{ routes.cart_add_url }}" class="purelane-cart-form">
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id | default: 1 }}">
      <button type="submit" class="btn btn-ghost btn-sm">Add to cart</button>
    </form>
  {% else %}
    <button class="btn btn-ghost btn-sm" disabled aria-disabled="true">Sold out</button>
  {% endif %}
</article>
