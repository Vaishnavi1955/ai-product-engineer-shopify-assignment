{% comment %}
  Purelane Theme - The Full Range Shelf Section
  Visual Source of Truth: purelane-homepage.html lines 1435-1451
{% endcomment %}

{{ 'purelane-theme.css' | asset_url | stylesheet_tag }}

<section class="sec" id="range" data-scene="3">
  <div class="wrap">
    <div class="glass range rv">
      <div class="range-head">
        <div>
          <span class="kicker">{{ section.settings.kicker | default: 'The full range' }}</span>
          <h2 class="d2" style="margin-top:10px">{{ section.settings.title | default: 'Every room, one shelf' }}</h2>
        </div>
        <p class="body-s" style="max-width:34ch;margin-bottom:4px">
          {{ section.settings.subtitle | default: 'Floors, taps, kitchen, laundry, bathroom and hands. Fourteen plant-based formulas that replace every harsh bottle under your sink.' }}
        </p>
      </div>

      <div class="stripwrap">
        <div class="rangerow">
          {% assign collection = section.settings.collection | default: collections['all'] %}
          {% if collection and collection.products.size > 0 %}
            {% for product in collection.products limit: 12 %}
              <a href="{{ product.url }}" class="rangerow-link" aria-label="{{ product.title | escape }}" style="display:inline-flex;align-items:center;flex-shrink:0;">
                {% if product.featured_image %}
                  {% assign alt_txt = product.featured_image.alt | default: product.title | escape %}
                  {{
                    product.featured_image
                    | image_url: width: 240
                    | image_tag:
                      loading: 'lazy',
                      widths: '120, 240',
                      sizes: '120px',
                      alt: alt_txt,
                      style: 'height:116px;width:auto;object-fit:contain;'
                  }}
                {% else %}
                  <div style="height:116px;width:70px;display:flex;align-items:flex-end;justify-content:center;">
                    {% assign p_handle = product.handle | default: 'floor' %}
                    {% render 'purelane-product-icon', handle: p_handle %}
                  </div>
                {% endif %}
              </a>
            {% endfor %}
          {% else %}
            <div style="height:116px;width:70px;display:flex;align-items:flex-end;justify-content:center;">{% render 'purelane-product-icon', handle: 'floor' %}</div>
            <div style="height:116px;width:70px;display:flex;align-items:flex-end;justify-content:center;">{% render 'purelane-product-icon', handle: 'tap' %}</div>
            <div style="height:116px;width:70px;display:flex;align-items:flex-end;justify-content:center;">{% render 'purelane-product-icon', handle: 'kitchen' %}</div>
            <div style="height:116px;width:70px;display:flex;align-items:flex-end;justify-content:center;">{% render 'purelane-product-icon', handle: 'toilet' %}</div>
            <div style="height:116px;width:70px;display:flex;align-items:flex-end;justify-content:center;">{% render 'purelane-product-icon', handle: 'laundry' %}</div>
            <div style="height:116px;width:70px;display:flex;align-items:flex-end;justify-content:center;">{% render 'purelane-product-icon', handle: 'dish' %}</div>
            <div style="height:116px;width:70px;display:flex;align-items:flex-end;justify-content:center;">{% render 'purelane-product-icon', handle: 'metal' %}</div>
            <div style="height:116px;width:70px;display:flex;align-items:flex-end;justify-content:center;">{% render 'purelane-product-icon', handle: 'wm' %}</div>
            <div style="height:116px;width:70px;display:flex;align-items:flex-end;justify-content:center;">{% render 'purelane-product-icon', handle: 'handwash' %}</div>
            <div style="height:116px;width:70px;display:flex;align-items:flex-end;justify-content:center;">{% render 'purelane-product-icon', handle: 'eraser' %}</div>
          {% endif %}
        </div>
      </div>
      <p class="striphint">Swipe to see the full shelf</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Full Range",
  "tag": "section",
  "class": "purelane-full-range-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The full range" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Every room, one shelf" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Floors, taps, kitchen, laundry, bathroom and hands. Fourteen plant-based formulas that replace every harsh bottle under your sink." },
    { "type": "collection", "id": "collection", "label": "Collection (Optional)" }
  ],
  "presets": [
    { "name": "Purelane Full Range" }
  ]
}
{% endschema %}
