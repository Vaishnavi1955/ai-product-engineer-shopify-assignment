{% comment %}
  Purelane Theme - Reviews Rail Section
  Visual Source of Truth: purelane-homepage.html lines 999-1011
{% endcomment %}

{{ 'purelane-theme.css' | asset_url | stylesheet_tag }}

<section class="sec revband" id="reviews" data-scene="1">
  <div class="wrap">
    <div class="revhead rv">
      <span class="kicker">{{ section.settings.kicker | default: 'That&#39;s what they said' }}</span>
      <span class="agg">
        <span class="st">★★★★★</span>
        <b>{{ section.settings.rating_score | default: '4.8' }}</b> from {{ section.settings.rating_count | default: '8,000+' }} reviews
      </span>
      <span class="agg">Loved by <b>{{ section.settings.homes_count | default: '12 lakh+' }}</b> homes</span>
    </div>
  </div>

  <div class="revrail rv" aria-label="Customer reviews">
    <div class="revtrack">
      {% comment %} Loop review blocks twice for seamless CSS marquee loop {% endcomment %}
      {% for i in (1..2) %}
        {% for block in section.blocks %}
          <article class="glass-2 rcard" {{ block.shopify_attributes }}>
            <div class="st">{{ block.settings.stars | default: '★★★★★' }}</div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.quote }}</p>
            <div class="who">
              {% render 'purelane-svg-icons', icon: 'check' %}
              <b>{{ block.settings.author }}</b>
              <span>&middot; {{ block.settings.product_tag }}</span>
            </div>
          </article>
        {% else %}
          {% comment %} Default Presets Matching Reference HTML {% endcomment %}
          <article class="glass-2 rcard">
            <div class="st">★★★★★</div>
            <h3>Works like a charm</h3>
            <p>Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.</p>
            <div class="who">{% render 'purelane-svg-icons', icon: 'check' %}<b>Anita</b><span>&middot; Laundry detergent</span></div>
          </article>
          <article class="glass-2 rcard">
            <div class="st">★★★★★</div>
            <h3>Best dishwash ever</h3>
            <p>Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.</p>
            <div class="who">{% render 'purelane-svg-icons', icon: 'check' %}<b>Priya</b><span>&middot; Dishwash gel</span></div>
          </article>
          <article class="glass-2 rcard">
            <div class="st">★★★★★</div>
            <h3>Great product, great packaging</h3>
            <p>Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.</p>
            <div class="who">{% render 'purelane-svg-icons', icon: 'check' %}<b>Sunita</b><span>&middot; Liquid handwash</span></div>
          </article>
          <article class="glass-2 rcard">
            <div class="st">★★★★★</div>
            <h3>Dog friendly</h3>
            <p>We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.</p>
            <div class="who">{% render 'purelane-svg-icons', icon: 'check' %}<b>Rohit S.</b><span>&middot; Floor cleaner</span></div>
          </article>
          <article class="glass-2 rcard">
            <div class="st">★★★★★</div>
            <h3>Sparkling taps again</h3>
            <p>Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.</p>
            <div class="who">{% render 'purelane-svg-icons', icon: 'check' %}<b>Verified buyer</b><span>&middot; Tap cleaner</span></div>
          </article>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Reviews Rail",
  "tag": "section",
  "class": "purelane-reviews-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating Score",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "rating_count",
      "label": "Reviews Count",
      "default": "8,000+"
    },
    {
      "type": "text",
      "id": "homes_count",
      "label": "Homes Count",
      "default": "12 lakh+"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Item",
      "settings": [
        { "type": "text", "id": "stars", "label": "Stars Rating", "default": "★★★★★" },
        { "type": "text", "id": "title", "label": "Review Headline", "default": "Works like a charm" },
        { "type": "textarea", "id": "quote", "label": "Review Body", "default": "Finally an eco option that cleans as well as the chemical detergent I used for years." },
        { "type": "text", "id": "author", "label": "Reviewer Name", "default": "Anita" },
        { "type": "text", "id": "product_tag", "label": "Product Tag", "default": "Laundry detergent" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews Rail",
      "blocks": [
        { "type": "review", "settings": { "title": "Works like a charm", "author": "Anita", "product_tag": "Laundry detergent" } },
        { "type": "review", "settings": { "title": "Best dishwash ever", "author": "Priya", "product_tag": "Dishwash gel" } },
        { "type": "review", "settings": { "title": "Great product, great packaging", "author": "Sunita", "product_tag": "Liquid handwash" } },
        { "type": "review", "settings": { "title": "Dog friendly", "author": "Rohit S.", "product_tag": "Floor cleaner" } },
        { "type": "review", "settings": { "title": "Sparkling taps again", "author": "Verified buyer", "product_tag": "Tap cleaner" } }
      ]
    }
  ]
}
{% endschema %}
