{% comment %}
  Purelane Theme - Best Selling Combos Section
  Visual Source of Truth: purelane-homepage.html lines 1180-1194
{% endcomment %}

{{ 'purelane-theme.css' | asset_url | stylesheet_tag }}

<section class="sec" id="combos" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker | default: 'Pre-built to save you money' }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.title | default: 'Best selling combos' }}</h2>
      <div class="rule">
        <i></i>
        {% render 'purelane-svg-icons', icon: 'plant' %}
        <i></i>
      </div>
      <p class="lede" style="margin:14px auto 0">
        {{ section.settings.subtitle | default: 'Swipe through the boxes people order most. Each one is already priced below buying the same products on their own.' }}
      </p>
    </div>

    <div class="comborail rv">
      {% for block in section.blocks %}
        <article class="glass combo{% if block.settings.is_hero %} hero-combo{% endif %}" {{ block.shopify_attributes }}>
          <div class="tray">
            {% if block.settings.save_text != blank %}
              <span class="save">{{ block.settings.save_text }}</span>
            {% endif %}
            {% if block.settings.flag_text != blank %}
              <span class="flag">{{ block.settings.flag_text }}</span>
            {% endif %}
            <div class="stack">
              <span class="it">
                {% if block.settings.image_1 %}
                  <img src="{{ block.settings.image_1 | image_url: width: 120 }}" alt="{{ block.settings.item_1_label | escape }}">
                {% else %}
                  <span class="pimg {{ block.settings.item_1_class | default: 'p-kitchen' }}" role="img"></span>
                {% endif %}
                <span>{{ block.settings.item_1_label | default: 'Cuts grease' }}</span>
              </span>
              <span class="plus" aria-hidden="true">+</span>
              <span class="it">
                {% if block.settings.image_2 %}
                  <img src="{{ block.settings.image_2 | image_url: width: 120 }}" alt="{{ block.settings.item_2_label | escape }}">
                {% else %}
                  <span class="pimg {{ block.settings.item_2_class | default: 'p-dish' }}" role="img"></span>
                {% endif %}
                <span>{{ block.settings.item_2_label | default: 'Clean dishes' }}</span>
              </span>
              <span class="plus" aria-hidden="true">+</span>
              <span class="it">
                {% if block.settings.image_3 %}
                  <img src="{{ block.settings.image_3 | image_url: width: 120 }}" alt="{{ block.settings.item_3_label | escape }}">
                {% else %}
                  <span class="pimg {{ block.settings.item_3_class | default: 'p-tap' }}" role="img"></span>
                {% endif %}
                <span>{{ block.settings.item_3_label | default: 'Melts stains' }}</span>
              </span>
            </div>
          </div>
          <div class="body">
            <h3>{{ block.settings.title }}</h3>
            <div class="cnt">{{ block.settings.count_text }}</div>
            <p class="inc">{{ block.settings.includes_text }}</p>
            <div class="prow">
              <strong>{{ block.settings.price }}</strong>
              {% if block.settings.compare_price != blank %}
                <s>{{ block.settings.compare_price }}</s>
              {% endif %}
              {% if block.settings.badge_text != blank %}
                <em>{{ block.settings.badge_text }}</em>
              {% endif %}
            </div>
            <div class="fine">Inclusive of all taxes &middot; COD available</div>
            <a class="btn {% if block.settings.is_hero %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_link | default: '#bundles' }}">
              {{ block.settings.button_label | default: 'Shop bundle' }}
              {% render 'purelane-svg-icons', icon: 'arrow-right' %}
            </a>
          </div>
        </article>
      {% else %}
        {% comment %} Default Presets Matching Reference HTML {% endcomment %}
        <article class="glass combo">
          <div class="tray">
            <span class="save">You save ₹398</span>
            <span class="flag">Most popular</span>
            <div class="stack">
              <span class="it"><span class="pimg p-kitchen" role="img"></span><span>Cuts grease instantly</span></span>
              <span class="plus" aria-hidden="true">+</span>
              <span class="it"><span class="pimg p-dish" role="img"></span><span>Squeaky clean dishes</span></span>
              <span class="plus" aria-hidden="true">+</span>
              <span class="it"><span class="pimg p-tap" role="img"></span><span>Melts hard water stains</span></span>
            </div>
          </div>
          <div class="body">
            <h3>Kitchen essentials</h3>
            <div class="cnt">3 products</div>
            <p class="inc">Includes: Foaming Kitchen Cleaner, Dishwash Gel &amp; Tap Cleaner. Everything for a sparkling kitchen, no need to pick separately.</p>
            <div class="prow"><strong>₹499</strong><s>₹897</s><em>Save ₹398</em></div>
            <div class="fine">Inclusive of all taxes &middot; COD available</div>
            <a class="btn btn-ghost" href="#bundles">Shop bundle {% render 'purelane-svg-icons', icon: 'arrow-right' %}</a>
          </div>
        </article>

        <article class="glass combo">
          <div class="tray">
            <span class="save">You save ₹448</span>
            <div class="stack">
              <span class="it"><span class="pimg p-laundry" role="img"></span><span>Removes tough stains</span></span>
              <span class="plus" aria-hidden="true">+</span>
              <span class="it"><span class="tile">{% render 'purelane-svg-icons', icon: 'plant' %}</span><span>Softens every wash</span></span>
              <span class="plus" aria-hidden="true">+</span>
              <span class="it"><span class="pimg p-wm" role="img"></span><span>Cleans machine</span></span>
            </div>
          </div>
          <div class="body">
            <h3>Laundry care bundle</h3>
            <div class="cnt">3 products</div>
            <p class="inc">Includes: Laundry Detergent, Fabric Conditioner &amp; Machine Cleaner Powder. Softer, fresher wash, all in one box.</p>
            <div class="prow"><strong>₹499</strong><s>₹947</s><em>Save ₹448</em></div>
            <div class="fine">Inclusive of all taxes &middot; COD available</div>
            <a class="btn btn-ghost" href="#bundles">Shop bundle {% render 'purelane-svg-icons', icon: 'arrow-right' %}</a>
          </div>
        </article>

        <article class="glass combo hero-combo">
          <div class="tray">
            <span class="save">Biggest saving</span>
            <span class="flag">Best value</span>
            <div class="stack">
              <span class="it"><span class="pimg p-kitchen" role="img"></span><span>Cuts grease</span></span>
              <span class="plus" aria-hidden="true">+</span>
              <span class="it"><span class="pimg p-floor" role="img"></span><span>Kills 99.9% germs</span></span>
              <span class="plus" aria-hidden="true">+</span>
              <span class="it"><span class="pimg p-handwash" role="img"></span><span>Hydrating handwash</span></span>
            </div>
          </div>
          <div class="body">
            <h3>Complete home bundle</h3>
            <div class="cnt">5 products</div>
            <p class="inc">Includes: Kitchen Cleaner, Laundry Detergent, Floor Cleaner, Toilet Cleaner &amp; Handwash. Our biggest saving box.</p>
            <div class="prow"><strong>₹799</strong><s>₹1,495</s><em>Save ₹696</em></div>
            <div class="fine">Inclusive of all taxes &middot; COD available</div>
            <a class="btn btn-primary" href="#bundles">Shop bundle {% render 'purelane-svg-icons', icon: 'arrow-right' %}</a>
          </div>
        </article>

        <article class="glass combo">
          <div class="tray">
            <span class="save">You save ₹398</span>
            <div class="stack">
              <span class="it"><span class="pimg p-toilet" role="img"></span><span>Kills 99.9% germs</span></span>
              <span class="plus" aria-hidden="true">+</span>
              <span class="it"><span class="pimg p-tap" role="img"></span><span>Melts limescale</span></span>
              <span class="plus" aria-hidden="true">+</span>
              <span class="it"><span class="pimg p-eraser" role="img"></span><span>Scrubs soap scum</span></span>
            </div>
          </div>
          <div class="body">
            <h3>Bathroom deep clean</h3>
            <div class="cnt">3 products</div>
            <p class="inc">Includes: Toilet Cleaner, Tap Cleaner &amp; Magic Eraser. A complete bathroom refresh in one box.</p>
            <div class="prow"><strong>₹499</strong><s>₹897</s><em>Save ₹398</em></div>
            <div class="fine">Inclusive of all taxes &middot; COD available</div>
            <a class="btn btn-ghost" href="#bundles">Shop bundle {% render 'purelane-svg-icons', icon: 'arrow-right' %}</a>
          </div>
        </article>
      {% endfor %}
    </div>

    <div class="swipecue" aria-hidden="true">
      {% render 'purelane-svg-icons', icon: 'arrow-right' %}
      Swipe for more combos
    </div>
    <p class="railnote">Tapping &quot;Shop bundle&quot; opens the bundle picker with these products already added. You can still swap anything before you pay.</p>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Combos Rail",
  "tag": "section",
  "class": "purelane-combos-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo Card",
      "settings": [
        { "type": "checkbox", "id": "is_hero", "label": "Highlight as Hero/Best Value", "default": false },
        { "type": "text", "id": "title", "label": "Combo Title", "default": "Kitchen essentials" },
        { "type": "text", "id": "save_text", "label": "Save Tag Text", "default": "You save ₹398" },
        { "type": "text", "id": "flag_text", "label": "Flag Badge Text", "default": "Most popular" },
        { "type": "text", "id": "count_text", "label": "Product Count Text", "default": "3 products" },
        { "type": "textarea", "id": "includes_text", "label": "Includes Description", "default": "Includes: Foaming Kitchen Cleaner, Dishwash Gel & Tap Cleaner." },
        { "type": "text", "id": "price", "label": "Price", "default": "₹499" },
        { "type": "text", "id": "compare_price", "label": "Compare Price", "default": "₹897" },
        { "type": "text", "id": "badge_text", "label": "Discount Badge Text", "default": "Save ₹398" },
        { "type": "text", "id": "button_label", "label": "Button Label", "default": "Shop bundle" },
        { "type": "url", "id": "button_link", "label": "Button Link" },
        { "type": "text", "id": "item_1_class", "label": "Item 1 CSS Class", "default": "p-kitchen" },
        { "type": "text", "id": "item_1_label", "label": "Item 1 Label", "default": "Cuts grease" },
        { "type": "text", "id": "item_2_class", "label": "Item 2 CSS Class", "default": "p-dish" },
        { "type": "text", "id": "item_2_label", "label": "Item 2 Label", "default": "Clean dishes" },
        { "type": "text", "id": "item_3_class", "label": "Item 3 CSS Class", "default": "p-tap" },
        { "type": "text", "id": "item_3_label", "label": "Item 3 Label", "default": "Melts stains" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Combos Rail"
    }
  ]
}
{% endschema %}
