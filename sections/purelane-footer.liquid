{% comment %}
  Purelane Theme - Footer Section
  Visual Source of Truth: purelane-homepage.html lines 1518-1559
{% endcomment %}

{{ 'purelane-theme.css' | asset_url | stylesheet_tag }}

<footer class="purelane-footer" data-scene="4">
  <div class="wrap">
    <div class="fgrid">
      {% comment %} Brand Column {% endcomment %}
      <div class="fcol">
        <a class="brand" href="{{ routes.root_url }}" style="margin-bottom:16px">
          <span class="mark">
            {% render 'purelane-svg-icons', icon: 'leaf-mark' %}
          </span>
          <span class="txt">
            <span class="n1">{{ section.settings.brand_title | default: 'Purelane' }}</span>
            <span class="n2">{{ section.settings.brand_subtitle | default: 'Clean, simply' }}</span>
          </span>
        </a>
        <p style="max-width:30ch">
          {{ section.settings.about_text | default: 'Effective cleaning, powered by nature. Made for Indian homes since day one.' }}
        </p>
      </div>

      {% comment %} Shop Column {% endcomment %}
      <div class="fcol">
        <h5>Shop</h5>
        <a href="#shop">Bestsellers</a>
        <a href="#shop">Kitchen</a>
        <a href="#shop">Laundry</a>
        <a href="#shop">Home</a>
        <a href="#shop">Skin</a>
        <a href="#bundles">Starter kits</a>
      </div>

      {% comment %} About Column {% endcomment %}
      <div class="fcol">
        <h5>About</h5>
        <a href="#how">How it works</a>
        <a href="#ingredients">Sustainability</a>
        <a href="#proof">FAQs</a>
        <a href="#reviews">Reviews</a>
      </div>

      {% comment %} Contact Column {% endcomment %}
      <div class="fcol">
        <h5>Get in touch</h5>
        <a href="mailto:{{ section.settings.email | default: 'hello@purelane.com' }}">{{ section.settings.email | default: 'hello@purelane.com' }}</a>
        <a href="tel:{{ section.settings.phone | default: '+919930123234' }}">{{ section.settings.phone_display | default: '+91 9930 123 234' }}</a>
        <p style="font-size:12px;color:rgba(36,26,61,.5)">{{ section.settings.company_name | default: 'Purelane Eco Products Pvt Ltd' }}</p>
      </div>
    </div>

    <div class="fbot">
      <span>© {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text | default: 'Purelane Eco Products Private Limited' }}</span>
      <span>Privacy &middot; Terms &middot; Refunds &middot; Contact</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Purelane Footer",
  "tag": "section",
  "class": "purelane-footer-section",
  "settings": [
    { "type": "text", "id": "brand_title", "label": "Brand Title", "default": "Purelane" },
    { "type": "text", "id": "brand_subtitle", "label": "Brand Subtitle", "default": "Clean, simply" },
    { "type": "textarea", "id": "about_text", "label": "About Copy", "default": "Effective cleaning, powered by nature. Made for Indian homes since day one." },
    { "type": "text", "id": "email", "label": "Contact Email", "default": "hello@purelane.com" },
    { "type": "text", "id": "phone", "label": "Contact Phone Link", "default": "+919930123234" },
    { "type": "text", "id": "phone_display", "label": "Contact Phone Display", "default": "+91 9930 123 234" },
    { "type": "text", "id": "company_name", "label": "Company Legal Name", "default": "Purelane Eco Products Pvt Ltd" },
    { "type": "text", "id": "copyright_text", "label": "Copyright Text", "default": "Purelane Eco Products Private Limited" }
  ],
  "presets": [
    { "name": "Purelane Footer" }
  ]
}
{% endschema %}
