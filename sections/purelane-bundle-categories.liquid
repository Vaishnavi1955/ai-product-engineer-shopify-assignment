{% comment %}
  Purelane Theme - Bundle Categories Section
  Visual Source of Truth: purelane-homepage.html lines 1466-1475
{% endcomment %}

{{ 'purelane-theme.css' | asset_url | stylesheet_tag }}

<section class="sec" id="categories" data-scene="4">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker | default: 'Bundle categories' }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.title | default: 'Find the right bundle for you' }}</h2>
    </div>
    <div class="cats">
      {% for block in section.blocks %}
        <a class="glass cat rv{% if forloop.index > 1 %} rv-d{{ forloop.index | minus: 1 }}{% endif %}" href="{{ block.settings.link | default: '#combos' }}" {{ block.shopify_attributes }}>
          <span class="ph">
            {% if block.settings.image %}
              {{
                block.settings.image
                | image_url: width: 300
                | image_tag:
                  loading: 'lazy',
                  widths: '150, 300',
                  sizes: '150px',
                  class: 'pimg',
                  style: 'height:80px;width:auto;object-fit:contain;'
              }}
            {% else %}
              <div style="height:80px;width:60px;display:flex;align-items:center;justify-content:center;">
                {% render 'purelane-product-icon', handle: block.settings.img_class %}
              </div>
            {% endif %}
          </span>
          <span class="txt">
            <h4>{{ block.settings.title }}</h4>
            <p>{{ block.settings.subtitle }}</p>
          </span>
        </a>
      {% else %}
        <a class="glass cat rv" href="#combos">
          <span class="ph"><div style="height:80px;width:60px;display:flex;align-items:center;justify-content:center;">{% render 'purelane-product-icon', handle: 'kitchen' %}</div></span>
          <span class="txt"><h4>Kitchen bundle</h4><p>Grease, dishes &amp; more</p></span>
        </a>
        <a class="glass cat rv rv-d1" href="#combos">
          <span class="ph"><div style="height:80px;width:60px;display:flex;align-items:center;justify-content:center;">{% render 'purelane-product-icon', handle: 'toilet' %}</div></span>
          <span class="txt"><h4>Bathroom bundle</h4><p>Deep clean &amp; disinfect</p></span>
        </a>
        <a class="glass cat rv rv-d2" href="#combos">
          <span class="ph"><div style="height:80px;width:60px;display:flex;align-items:center;justify-content:center;">{% render 'purelane-product-icon', handle: 'laundry' %}</div></span>
          <span class="txt"><h4>Laundry bundle</h4><p>Softer, fresher wash</p></span>
        </a>
        <a class="glass cat rv rv-d3" href="#combos">
          <span class="ph"><div style="height:80px;width:60px;display:flex;align-items:center;justify-content:center;">{% render 'purelane-product-icon', handle: 'tap' %}</div></span>
          <span class="txt"><h4>Hard water bundle</h4><p>Melt away limescale</p></span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Categories",
  "tag": "section",
  "class": "purelane-categories-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bundle categories" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Find the right bundle for you" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Kitchen bundle" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Grease, dishes & more" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Custom Image" },
        { "type": "text", "id": "img_class", "label": "Fallback Product Image Class", "default": "p-kitchen" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Kitchen bundle", "subtitle": "Grease, dishes & more", "img_class": "p-kitchen" } },
        { "type": "category", "settings": { "title": "Bathroom bundle", "subtitle": "Deep clean & disinfect", "img_class": "p-toilet" } },
        { "type": "category", "settings": { "title": "Laundry bundle", "subtitle": "Softer, fresher wash", "img_class": "p-laundry" } },
        { "type": "category", "settings": { "title": "Hard water bundle", "subtitle": "Melt away limescale", "img_class": "p-tap" } }
      ]
    }
  ]
}
{% endschema %}
