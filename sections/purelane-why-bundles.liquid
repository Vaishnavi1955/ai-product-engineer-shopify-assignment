{% comment %}
  Purelane Theme - Why Bundles Beat Buying Single Section
  Visual Source of Truth: purelane-homepage.html lines 1453-1464
{% endcomment %}

{{ 'purelane-theme.css' | asset_url | stylesheet_tag }}

<section class="sec" id="whybundles" data-scene="4">
  <div class="wrap">
    <div class="glass sec-pad rv">
      <div class="panel-head">
        <span class="kicker">{{ section.settings.kicker | default: 'The smarter way to shop' }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.title | default: 'Why bundles beat buying single' }}</h2>
      </div>
      <div class="wb">
        {% for block in section.blocks %}
          <div class="wb-i" {{ block.shopify_attributes }}>
            <span class="ci">
              {% render 'purelane-svg-icons', icon: block.settings.icon %}
            </span>
            <h4>{{ block.settings.title }}</h4>
            <p>{{ block.settings.text }}</p>
          </div>
        {% else %}
          <div class="wb-i">
            <span class="ci">{% render 'purelane-svg-icons', icon: 'dollar' %}</span>
            <h4>Save up to 45%</h4>
            <p>Versus buying the same products separately</p>
          </div>
          <div class="wb-i">
            <span class="ci">{% render 'purelane-svg-icons', icon: 'box-check' %}</span>
            <h4>One flat price</h4>
            <p>No calculators, no comparing carts</p>
          </div>
          <div class="wb-i">
            <span class="ci">{% render 'purelane-svg-icons', icon: 'star' %}</span>
            <h4>Curated by experts</h4>
            <p>Products picked to work well together</p>
          </div>
          <div class="wb-i">
            <span class="ci">{% render 'purelane-svg-icons', icon: 'truck' %}</span>
            <h4>Free shipping always</h4>
            <p>Included on every bundle, all India</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Why Bundles",
  "tag": "section",
  "class": "purelane-why-bundles-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The smarter way to shop" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Why bundles beat buying single" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "dollar", "label": "Dollar/Save" },
            { "value": "box-check", "label": "Box Check" },
            { "value": "star", "label": "Star" },
            { "value": "truck", "label": "Truck/Free Shipping" }
          ],
          "default": "dollar"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Save up to 45%" },
        { "type": "text", "id": "text", "label": "Description", "default": "Versus buying the same products separately" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Why Bundles",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "dollar", "title": "Save up to 45%", "text": "Versus buying the same products separately" } },
        { "type": "benefit", "settings": { "icon": "box-check", "title": "One flat price", "text": "No calculators, no comparing carts" } },
        { "type": "benefit", "settings": { "icon": "star", "title": "Curated by experts", "text": "Products picked to work well together" } },
        { "type": "benefit", "settings": { "icon": "truck", "title": "Free shipping always", "text": "Included on every bundle, all India" } }
      ]
    }
  ]
}
{% endschema %}
