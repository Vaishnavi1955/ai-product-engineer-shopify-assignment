{% comment %}
  Purelane Theme - Global Header & Navigation Section
  Visual Source of Truth: purelane-homepage.html lines 826-870, 901-940
  Supports dynamic Shopify menus, subpage routing, and mobile drawer
{% endcomment %}

{{ 'purelane-theme.css' | asset_url | stylesheet_tag }}

{% comment %} Ticker Announcement Bar {% endcomment %}
{% if section.settings.show_ticker %}
  <div class="ticker">
    <div class="track">
      <span><b>FREE SHIPPING</b> ACROSS INDIA ON ALL ORDERS</span>
      <span>PLANT-POWERED HOMECARE &middot; <b>NO HARSH CHEMICALS</b></span>
      <span>OVER 12 LAKH+ HOMES TRUST <b>PURELANE</b></span>
      <span><b>FREE SHIPPING</b> ACROSS INDIA ON ALL ORDERS</span>
      <span>PLANT-POWERED HOMECARE &middot; <b>NO HARSH CHEMICALS</b></span>
    </div>
  </div>
{% endif %}

{% comment %} Header Navigation Bar {% endcomment %}
<header id="hdr" class="purelane-header">
  <div class="navpill glass">
    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }} Home">
      <span class="mark">
        {% render 'purelane-svg-icons', icon: 'leaf-mark' %}
      </span>
      <span class="txt">
        <span class="n1">{{ section.settings.brand_title | default: 'Purelane' }}</span>
        <span class="n2">{{ section.settings.brand_subtitle | default: 'Clean, simply' }}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main navigation">
      {% if section.settings.menu != blank and section.settings.menu.links.size > 0 %}
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}"{% if link.current %} class="active"{% endif %}>{{ link.title }}</a>
        {% endfor %}
      {% else %}
        <a href="{{ routes.root_url }}">Home</a>
        <a href="{{ routes.all_products_collection_url }}">Catalog</a>
        <a href="{% if template.name == 'index' %}#bundles{% else %}{{ routes.root_url }}#bundles{% endif %}">Bundles</a>
        <a href="{{ pages['about-us'].url | default: '/pages/about-us' }}">About Us</a>
        <a href="{{ pages['contact'].url | default: '/pages/contact' }}">Contact</a>
      {% endif %}
    </nav>

    <div class="navtools">
      <a href="{{ routes.search_url }}" class="ico hide-s" aria-label="Search">
        {% render 'purelane-svg-icons', icon: 'search' %}
      </a>
      <a href="{{ routes.account_url }}" class="ico hide-s" aria-label="Account">
        {% render 'purelane-svg-icons', icon: 'account' %}
      </a>
      <a href="{{ routes.cart_url }}" class="ico" aria-label="Cart, {{ cart.item_count }} items">
        {% render 'purelane-svg-icons', icon: 'cart' %}
        <span class="dot">{{ cart.item_count }}</span>
      </a>
      <button class="ico burger" id="burgerBtn" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobileDrawer">
        {% render 'purelane-svg-icons', icon: 'menu' %}
      </button>
    </div>
  </div>
</header>

{% comment %} Mobile Navigation Drawer {% endcomment %}
<div class="mobile-drawer" id="mobileDrawer" aria-hidden="true">
  <div class="drawer-backdrop" id="drawerBackdrop"></div>
  <div class="glass drawer-panel">
    <div class="drawer-header">
      <a class="brand" href="{{ routes.root_url }}">
        <span class="mark">{% render 'purelane-svg-icons', icon: 'leaf-mark' %}</span>
        <span class="txt">
          <span class="n1">{{ section.settings.brand_title | default: 'Purelane' }}</span>
          <span class="n2">{{ section.settings.brand_subtitle | default: 'Clean, simply' }}</span>
        </span>
      </a>
      <button class="drawer-close" id="drawerCloseBtn" aria-label="Close menu">&times;</button>
    </div>

    <nav class="drawer-links" aria-label="Mobile Navigation">
      {% if section.settings.menu != blank and section.settings.menu.links.size > 0 %}
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}" class="drawer-link">{{ link.title }}</a>
        {% endfor %}
      {% else %}
        <a href="{{ routes.root_url }}" class="drawer-link">Home</a>
        <a href="{{ routes.all_products_collection_url }}" class="drawer-link">Catalog (All Products)</a>
        <a href="{% if template.name == 'index' %}#bundles{% else %}{{ routes.root_url }}#bundles{% endif %}" class="drawer-link">Build Your Bundle</a>
        <a href="{% if template.name == 'index' %}#combos{% else %}{{ routes.root_url }}#combos{% endif %}" class="drawer-link">Best-Selling Combos</a>
        <a href="{{ pages['about-us'].url | default: '/pages/about-us' }}" class="drawer-link">About Us</a>
        <a href="{{ pages['contact'].url | default: '/pages/contact' }}" class="drawer-link">Contact Support</a>
        <a href="{{ shop.policies.shipping_policy.url | default: pages['shipping-delivery'].url | default: '/pages/shipping-delivery' }}" class="drawer-link">Shipping &amp; Delivery</a>
        <a href="{{ shop.policies.refund_policy.url | default: pages['refund-policy'].url | default: '/pages/refund-policy' }}" class="drawer-link">Refund &amp; Returns</a>
      {% endif %}
    </nav>

    <div class="drawer-footer">
      <div class="drawer-tools">
        <a href="{{ routes.account_url }}" class="btn btn-ghost btn-sm" style="flex:1;justify-content:center;">
          {% render 'purelane-svg-icons', icon: 'account' %} Account
        </a>
        <a href="{{ routes.cart_url }}" class="btn btn-primary btn-sm" style="flex:1;justify-content:center;">
          {% render 'purelane-svg-icons', icon: 'cart' %} Cart ({{ cart.item_count }})
        </a>
      </div>
      <p style="font-size:11.5px;color:var(--paper-3);margin-top:14px;text-align:center;">
        Free shipping across India on all orders.
      </p>
    </div>
  </div>
</div>

{% comment %} Progress Rail - Only rendered on Homepage {% endcomment %}
{% if template.name == 'index' %}
  <nav class="rail" aria-label="Section progress">
    <a href="#top" class="on" aria-label="Hero"></a>
    <a href="#ingredients" aria-label="Ingredients"></a>
    <a href="#how" aria-label="How it works"></a>
    <a href="#proof" aria-label="Proof"></a>
    <a href="#bundles" aria-label="Bundles"></a>
    <a href="#shop" aria-label="Shop"></a>
    <a href="#reviews" aria-label="Reviews"></a>
  </nav>
{% endif %}

{% schema %}
{
  "name": "Purelane Header & Chrome",
  "tag": "section",
  "class": "purelane-header-section",
  "settings": [
    { "type": "checkbox", "id": "show_ticker", "label": "Show Ticker Bar", "default": true },
    { "type": "text", "id": "brand_title", "label": "Brand Title", "default": "Purelane" },
    { "type": "text", "id": "brand_subtitle", "label": "Brand Subtitle", "default": "Clean, simply" },
    { "type": "link_list", "id": "menu", "label": "Navigation Menu" }
  ],
  "presets": [
    { "name": "Purelane Header & Chrome" }
  ]
}
{% endschema %}
