{% comment %}
  Purelane Theme - Newsletter Signup Section
  Visual Source of Truth: purelane-homepage.html lines 1501-1515
{% endcomment %}

{{ 'purelane-theme.css' | asset_url | stylesheet_tag }}

<section class="sec" data-scene="4">
  <div class="wrap">
    <div class="glass signup rv">
      <span class="kicker">{{ section.settings.kicker | default: 'Join the Purelane Club' }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.title | default: 'Get ₹100 off your first bundle' }}</h2>
      <p class="lede" style="margin:0 auto">
        {{ section.settings.subtitle | default: 'Plus first access to new launches and restocks.' }}
      </p>

      {% form 'customer', class: 'purelane-newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div style="display:flex;gap:9px;max-width:430px;margin:22px auto 0;flex-wrap:wrap;width:100%;">
          <input
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.placeholder | default: 'your@email.com' }}"
            aria-label="Email address"
            required
            value="{{ form.email }}"
          >
          <button class="btn btn-primary" type="submit">
            {{ section.settings.button_label | default: 'Get my ₹100 off' }}
          </button>
        </div>
        {% if form.posted_successfully? %}
          <p style="margin-top:12px;color:var(--accent);font-weight:700;">Thank you for subscribing!</p>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Newsletter",
  "tag": "section",
  "class": "purelane-newsletter-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Join the Purelane Club" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Get ₹100 off your first bundle" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Plus first access to new launches and restocks." },
    { "type": "text", "id": "placeholder", "label": "Input Placeholder", "default": "your@email.com" },
    { "type": "text", "id": "button_label", "label": "Button Label", "default": "Get my ₹100 off" }
  ],
  "presets": [
    { "name": "Purelane Newsletter" }
  ]
}
{% endschema %}
