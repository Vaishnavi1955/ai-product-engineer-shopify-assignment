{% comment %}
  Purelane Theme - Proof & Product Rotator Section
  Visual Source of Truth: purelane-homepage.html lines 1137-1178
{% endcomment %}

{{ 'purelane-theme.css' | asset_url | stylesheet_tag }}

<section class="sec" id="proof" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv">
      <div class="proof">
        <div class="proof-l">
          <span class="kicker">{{ section.settings.kicker | default: 'Why it works' }}</span>
          <h2 class="d2" style="margin-top:12px">
            {{ section.settings.title | default: 'Tough on grime.<br>Gentle on everything else.' }}
          </h2>
          <p class="body-s" style="max-width:40ch">
            {{ section.settings.subtitle | default: 'Every formula is built on plant-derived cleansers and essential oils. It behaves exactly like the cleaner you are used to, minus the things you never signed up for.' }}
          </p>
          {% if section.settings.button_label != blank %}
            <a class="btn btn-primary" href="{{ section.settings.button_link | default: '#ingredients' }}">
              {{ section.settings.button_label }}
              {% render 'purelane-svg-icons', icon: 'arrow-right' %}
            </a>
          {% endif %}
        </div>

        {% comment %} Product Rotator Carousel {% endcomment %}
        <div class="glass-2 rot" id="rot" aria-hidden="true">
          <div class="frame">
            <div class="rot-item on" data-name="Kitchen cleaner" data-note="Foam lifts grease, no scrubbing" style="height:180px;display:flex;align-items:center;justify-content:center;">
              {% render 'purelane-product-icon', handle: 'kitchen' %}
            </div>
            <div class="rot-item" data-name="Tap &amp; limescale" data-note="Melts hard water stains" style="height:180px;display:none;align-items:center;justify-content:center;">
              {% render 'purelane-product-icon', handle: 'tap' %}
            </div>
            <div class="rot-item" data-name="Laundry detergent" data-note="Tough on odour, soft on fabric" style="height:180px;display:none;align-items:center;justify-content:center;">
              {% render 'purelane-product-icon', handle: 'laundry' %}
            </div>
            <div class="rot-item" data-name="Toilet cleaner" data-note="Kills 99.9% of germs" style="height:180px;display:none;align-items:center;justify-content:center;">
              {% render 'purelane-product-icon', handle: 'toilet' %}
            </div>
            <div class="rot-item" data-name="Floor cleaner" data-note="Neem powered, pet safe" style="height:180px;display:none;align-items:center;justify-content:center;">
              {% render 'purelane-product-icon', handle: 'floor' %}
            </div>
            <div class="rot-item" data-name="Dishwash gel" data-note="Cuts grease, kind to hands" style="height:180px;display:none;align-items:center;justify-content:center;">
              {% render 'purelane-product-icon', handle: 'dish' %}
            </div>
          </div>
          <div class="cap">
            <b>Kitchen cleaner</b>
            <span>Foam lifts grease, no scrubbing</span>
          </div>
          <div class="dots">
            <i class="on"></i><i></i><i></i><i></i><i></i><i></i>
          </div>
        </div>

        {% comment %} Stats Grid Row {% endcomment %}
        <div class="glass-2 stats proof-stats" style="grid-column:1/-1">
          {% for block in section.blocks %}
            <div class="stat" {{ block.shopify_attributes }}>
              <div class="ring">{{ block.settings.stat_value }}</div>
              <h5>{{ block.settings.stat_title }}</h5>
              <p>{{ block.settings.stat_desc }}</p>
            </div>
          {% else %}
            <div class="stat">
              <div class="ring">99.9%</div>
              <h5>Germ kill</h5>
              <p>Tested against germs and bacteria</p>
            </div>
            <div class="stat">
              <div class="ring">0%</div>
              <h5>Sulphates</h5>
              <p>No SLS, chlorine or parabens</p>
            </div>
            <div class="stat">
              <div class="ring">100%</div>
              <h5>Plant based</h5>
              <p>Cleansers derived from plants</p>
            </div>
            <div class="stat">
              <div class="ring">4.8</div>
              <h5>Rated</h5>
              <p>Across 8,000+ verified reviews</p>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Proof & Rotator",
  "tag": "section",
  "class": "purelane-proof-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Why it works" },
    { "type": "textarea", "id": "title", "label": "Heading", "default": "Tough on grime.<br>Gentle on everything else." },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Every formula is built on plant-derived cleansers and essential oils." },
    { "type": "text", "id": "button_label", "label": "Button Label", "default": "See the ingredient list" },
    { "type": "url", "id": "button_link", "label": "Button Link" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat Item",
      "settings": [
        { "type": "text", "id": "stat_value", "label": "Stat Number/Value", "default": "99.9%" },
        { "type": "text", "id": "stat_title", "label": "Stat Title", "default": "Germ kill" },
        { "type": "text", "id": "stat_desc", "label": "Stat Description", "default": "Tested against germs and bacteria" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Proof & Rotator",
      "blocks": [
        { "type": "stat", "settings": { "stat_value": "99.9%", "stat_title": "Germ kill", "stat_desc": "Tested against germs and bacteria" } },
        { "type": "stat", "settings": { "stat_value": "0%", "stat_title": "Sulphates", "stat_desc": "No SLS, chlorine or parabens" } },
        { "type": "stat", "settings": { "stat_value": "100%", "stat_title": "Plant based", "stat_desc": "Cleansers derived from plants" } },
        { "type": "stat", "settings": { "stat_value": "4.8", "stat_title": "Rated", "stat_desc": "Across 8,000+ verified reviews" } }
      ]
    }
  ]
}
{% endschema %}
