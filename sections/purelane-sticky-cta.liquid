{% comment %}
  Purelane Theme - Mobile Sticky CTA Section
  Visual Source of Truth: purelane-homepage.html lines 1561-1566
{% endcomment %}

{{ 'purelane-theme.css' | asset_url | stylesheet_tag }}

{% if section.settings.enable_sticky %}
  <div class="sticky">
    <span class="lbl">
      <b>{{ section.settings.bold_label | default: 'Pick any 3, pay ₹499' }}</b>
      <span>{{ section.settings.sub_label | default: 'Free shipping, always' }}</span>
    </span>
    <a class="btn btn-primary btn-sm" href="{{ section.settings.button_link | default: '#bundles' }}">
      {{ section.settings.button_label | default: 'Build bundle' }}
    </a>
  </div>
{% endif %}

{% schema %}
{
  "name": "Purelane Sticky Mobile CTA",
  "tag": "section",
  "class": "purelane-sticky-cta-section",
  "settings": [
    { "type": "checkbox", "id": "enable_sticky", "label": "Enable Sticky Mobile CTA", "default": true },
    { "type": "text", "id": "bold_label", "label": "Main Bold Offer Label", "default": "Pick any 3, pay ₹499" },
    { "type": "text", "id": "sub_label", "label": "Sub-label", "default": "Free shipping, always" },
    { "type": "text", "id": "button_label", "label": "Button Label", "default": "Build bundle" },
    { "type": "url", "id": "button_link", "label": "Button Link" }
  ],
  "presets": [
    { "name": "Purelane Sticky Mobile CTA" }
  ]
}
{% endschema %}
